{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Minimum permissions for the Ovren main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-show",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        },
        {
          "url": "mailto:*"
        }
      ]
    },
    "dialog:allow-open",
    "fs:allow-read-file",
    "fs:allow-stat",
    "log:allow-log",
    "os:allow-locale",
    "os:allow-platform",
    "process:allow-restart",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/ovrennet/ovrenNET",
          "sidecar": true,
          "args": ["snapshot", "-state-dir", { "validator": ".+" }]
        },
        {
          "name": "binaries/ovrennet/ovrenNET",
          "sidecar": true,
          "args": ["off", "-state-dir", { "validator": ".+" }]
        },
        {
          "name": "binaries/ovrennet/ovrenNET",
          "sidecar": true,
          "args": ["snapshot"]
        },
        {
          "name": "binaries/ovrennet/ovrenNET",
          "sidecar": true,
          "args": ["off"]
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/ovrennet/ovrenNET",
          "sidecar": true,
          "args": ["run", "-state-dir", { "validator": ".+" }, "-owner-pid", { "validator": "^[0-9]+$" }]
        },
        {
          "name": "binaries/ovrennet/ovrenNET",
          "sidecar": true,
          "args": ["run", "-owner-pid", { "validator": "^[0-9]+$" }]
        }
      ]
    },
    "store:default",
    "updater:default"
  ]
}
