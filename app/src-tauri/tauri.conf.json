{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ovren",
  "version": "1.3.4",
  "identifier": "dev.licht.ovren",
  "mainBinaryName": "Ovren",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "node scripts/generate-resident-icons.mjs && pnpm build:frontend && node scripts/build-privileged.mjs --release && node scripts/build-ovrennet.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:; img-src 'self' asset: http://asset.localhost data: blob:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; base-uri 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420; font-src 'self' data:; img-src 'self' asset: http://asset.localhost data: blob:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; base-uri 'none'; frame-ancestors 'none'"
    },
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Ovren",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 700,
        "center": true,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 16
        }
      }
    ]
  },
  "bundle": {
    "active": true,
    "android": {
      "versionCode": 1
    },
    "publisher": "Licht",
    "homepage": "https://github.com/lylicht/ovren",
    "copyright": "Copyright © 2026 Licht",
    "license": "GPL-3.0-only",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/ovrennet/ovrenNET"
    ],
    "resources": {
      "binaries/ovrennet/wintun*": "."
    },
    "targets": [
      "nsis",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "minimumWebview2Version": "111.0.1661.62",
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "English",
          "French",
          "German",
          "Italian",
          "Swedish",
          "Dutch",
          "SpanishInternational",
          "Portuguese",
          "PortugueseBR",
          "Norwegian",
          "Turkish",
          "Japanese",
          "SimpChinese",
          "TradChinese",
          "Korean",
          "Russian"
        ],
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY4MTRFQzNFOTM3ODkwQjAKUldTd2tIaVRQdXdVK0NRbW1lUlQvTTFtTEEvMzNhZ004Q2NCMWJlek9PSWJOOGl4S0UzaUtqVU8K",
      "endpoints": [
        "https://github.com/lylicht/ovren/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
