{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Ovren",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 700,
        "center": true,
        "visible": false,
        "decorations": false
      },
      {
        "label": "file-browser",
        "create": false,
        "url": "index.html?window=file-browser",
        "title": "Ovren",
        "width": 1180,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "resizable": true,
        "decorations": true
      }
    ]
  },
  "bundle": {
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
